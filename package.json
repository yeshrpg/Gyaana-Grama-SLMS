{
  "name": "gyaana-grama-slms",
  "version": "1.0.0",
  "description": "Smart Library Management System for Gyaana Grama village library",
  "main": "dist-electron/index.js",
  "build": {
    "appId": "com.gyaanagrama.slms",
    "productName": "Gyaana Grama SLMS",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "dist-electron/**/*", "db/**/*", "assets/**/*"],
    "win": {
      "target": "portable",
      "icon": "assets/icon.ico"
    },
    "icon": "assets/icon.ico",
    "portable": {
      "artifactName": "GyaanaGrama-SLMS.exe"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node -e \"require('fs').writeFileSync('dist/index.html', require('fs').readFileSync('dist/index.html','utf8').replace(/ crossorigin/g, ''))\" && electron-builder",
    "preview": "vite preview",
    "electron": "electron ."
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "i18next": "^23.11.5",
    "lucide-react": "^0.383.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.2",
    "sql.js": "^1.14.1",
    "vite-plugin-electron": "^1.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "vite": "^5.2.12"
  },
  "allowScripts": {
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
